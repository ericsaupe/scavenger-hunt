<% description "#{@team.name} is working hard to find everything on their scavenger hunt list: '#{@hunt.name}'." %>
<% title @hunt.name %>

<%= content_tag :div, nil, data: {
      controller: "past-hunts",
      "past-hunts-code-value": @hunt.code,
      "past-hunts-name-value": @hunt.name,
      "past-hunts-team-value": @team.name,
      "past-hunts-path-value": hunt_team_path(@hunt.code, @team)
    } %>

<div data-controller="checklist live queue" data-queue-team-id-value="<%= @team.id %>" data-queue-report-url-value="<%= pending_uploads_hunt_team_path(@hunt.code, @team) %>">
  <%= turbo_stream_from "submissions_#{@team.id}" %>
  <%= turbo_stream_from @team %>

  <div class="sticky top-14 z-20 border-b border-base-300 bg-base-100/95 backdrop-blur">
    <div class="page flex items-end justify-between gap-4 pt-3">
      <div class="min-w-0">
        <%= link_to @hunt.name, hunt_path(code: @hunt.code), class: "block truncate text-sm font-semibold text-ink-soft" %>
        <h1 class="display truncate text-2xl"><%= @team.name %></h1>
      </div>
      <div class="shrink-0 text-right">
        <p class="text-xs font-semibold text-ink-soft">Score</p>
        <p class="display text-3xl tabular-nums text-ink"><%= render partial: "score", locals: {team: @team} %></p>
      </div>
    </div>
    <div class="page pb-3 pt-2">
      <div class="flex items-center justify-between gap-3 text-xs font-semibold text-ink-soft">
        <span data-checklist-target="progress"></span>
        <% if @hunt.timer? %>
          <%= render partial: "hunts/timer", locals: {hunt: @hunt} %>
        <% end %>
      </div>
      <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-base-200">
        <div class="h-full rounded-full bg-marigold transition-[width] duration-500" data-checklist-target="bar" style="width: 0%"></div>
      </div>
    </div>
    <div data-controller="offline" data-offline-synced-at-value="<%= Time.current.to_i * 1000 %>">
      <p class="page flex items-center gap-2 border-t border-base-300 bg-base-200 py-2 text-xs font-semibold text-ink-soft" role="status" hidden data-offline-target="banner">
        <%= icon :cloud, class: "size-4 shrink-0" %>
        <span>Offline, last synced at <span data-offline-target="time"></span></span>
      </p>
    </div>
  </div>

  <p class="page pt-5 text-sm text-ink-soft">Tap an item to take a photo or a video up to <%= Submission::MAX_VIDEO_SECONDS %> seconds. Found items tick off for the whole team.</p>

  <% if @hunt.chat_available? %>
    <%= render partial: "messages/organizer_card", locals: {hunt: @hunt, message: @hunt.latest_announcement} %>
  <% end %>

  <div data-checklist-target="list">
    <%= render partial: "hunts/checklist" %>
  </div>

  <template id="queued_badge_template">
    <span class="absolute bottom-0 right-0 grid size-5 place-items-center rounded-tl-lg bg-base-100 text-ink-soft" data-testid="queued-badge"><%= icon :cloud, class: "size-3.5" %></span>
  </template>
</div>

<% if @hunt.chat_available? %>
  <%= render partial: "messages/chat", locals: {hunt: @hunt} %>
<% end %>
