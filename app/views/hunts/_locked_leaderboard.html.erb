<% if hunt.lock_password %>
  <div class="page mt-8">
    <div class="rounded-3xl bg-base-200 p-6">
      <span class="grid size-12 place-items-center rounded-2xl bg-neutral text-marigold"><%= icon :trophy, class: "size-6" %></span>
      <h2 class="display mt-4 text-2xl">Leaderboard is not yet available!</h2>
      <p class="mt-2 text-ink-soft">Scores stay hidden until the password is entered. The photos below are open.</p>
      <%= form_with url: unlock_leaderboard_hunt_path(code: hunt.code.upcase), method: :post, class: "mt-6" do |f| %>
        <%= f.label :password, "Password", class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.password_field :password, required: true, class: "input input-lg w-full", autofocus: true %>
        <button class="btn btn-primary btn-lg btn-block mt-3">Unlock leaderboard</button>
      <% end %>
    </div>
  </div>
<% end %>
