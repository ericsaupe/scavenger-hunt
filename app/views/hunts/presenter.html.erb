<%= turbo_stream_from "hunt_presenter_#{@hunt.id}" %>

<div class="flex min-h-dvh flex-col sm:h-dvh sm:flex-row" data-controller="presenter">
  <div class="relative flex min-h-dvh grow flex-col sm:min-h-0">
    <%= link_to hunt_results_path(@hunt.code.upcase), class: "absolute left-3 top-3 z-10 btn btn-ghost btn-sm text-white/70 hover:text-white" do %>
      <%= icon :arrow_left, class: "size-4" %>
      Results
    <% end %>

    <%= render(partial: "submissions/submission_presenter", locals: {submission: @submission}) %>

    <% if @hunt.owner?(cookies[:user_id]) %>
      <div class="sticky bottom-0 z-10 flex justify-center px-4 pb-[max(1rem,env(safe-area-inset-bottom))] sm:absolute sm:inset-x-0">
        <div class="flex items-center gap-1 rounded-full bg-white/10 p-1 backdrop-blur">
          <%= link_to(hunt_presenter_path(@hunt.code.upcase, submission_id: @previous_submission.id), class: "btn btn-circle btn-ghost text-white text-xl", data: {turbo_prefetch: false, "presenter-target": "previous"}, "aria-label": "Previous photo") do %>
            «
          <% end %>
          <span class="max-w-48 truncate px-2 text-sm font-semibold text-white"><%= @submission.item.name %></span>
          <%= link_to(hunt_presenter_path(@hunt.code.upcase, submission_id: @next_submission.id), class: "btn btn-circle btn-ghost text-white text-xl", data: {turbo_prefetch: false, "presenter-target": "next"}, "aria-label": "Next photo") do %>
            »
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @hunt.owner_id.blank? %>
      <div class="pb-[max(1rem,env(safe-area-inset-bottom))] text-center">
        <%= link_to(hunt_presenter_path(@hunt.code.upcase, become_presenter: true), class: "btn btn-link btn-sm text-white/70", data: {turbo_prefetch: false}) do %>
          Control this presentation
        <% end %>
      </div>
    <% end %>
  </div>

  <% if Flipper.enabled?(:chat) %>
    <div class="w-full shrink-0 border-t border-white/10 sm:w-80 sm:border-l sm:border-t-0">
      <%= render partial: "hunts/chat", locals: {hunt: @hunt} %>
    </div>
  <% end %>
</div>
