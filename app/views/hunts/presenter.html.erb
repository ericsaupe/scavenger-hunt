<% title "#{@hunt.name} on the big screen" %>
<%= render partial: "hunts/presenter_head" %>

<div class="flex min-h-dvh flex-col sm:h-dvh sm:flex-row" data-controller="live">
  <%= turbo_stream_from @hunt.presenter_stream, id: "presenter_stream", data: {turbo_permanent: true} %>
  <div class="relative flex min-h-dvh grow flex-col sm:min-h-0">
    <div class="absolute inset-x-0 top-0 z-10 flex items-center justify-between gap-3 px-3 pt-3">
      <%= link_to hunt_results_path(@hunt.code.upcase), class: "btn btn-ghost btn-sm text-white/70 hover:text-white" do %>
        <%= icon :arrow_left, class: "size-4" %>
        Results
      <% end %>
      <span class="status-pill bg-white/10 text-white/80" data-testid="progress">
        <%= @submission.video? ? "Video" : "Photo" %> <%= @presentation.position %> of <%= @presentation.count %>
      </span>
    </div>

    <%= render(partial: "submissions/submission_presenter", locals: {submission: @submission, hunt: @hunt, big_screen: @big_screen}) %>

    <div class="z-10 flex flex-col items-center gap-2 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] text-center text-sm text-white/70 sm:absolute sm:inset-x-0 sm:bottom-0">
      <% if @hunt.owner?(cookies[:user_id]) %>
        <p data-testid="presenting">You have the remote</p>
        <%= link_to "Open the remote", hunt_presenter_remote_path(@hunt.code.upcase), class: "btn btn-sm btn-ghost text-white" %>
      <% else %>
        <p data-testid="presenting"><%= @hunt.owner_id.present? ? "Someone else has the remote" : "No one has the remote yet" %></p>
        <% if @hunt.lock_password.present? %>
          <details class="group">
            <summary class="btn btn-sm btn-ghost list-none text-white">Take the remote</summary>
            <%= form_with url: claim_hunt_presentation_path(@hunt.code.upcase), method: :post, class: "mt-2 flex items-center gap-2" do |f| %>
              <%= f.password_field :password, placeholder: "Results password", required: true, autocomplete: "current-password", class: "input input-sm bg-white/10 text-white placeholder:text-white/50" %>
              <button class="btn btn-sm btn-primary">Take it</button>
            <% end %>
          </details>
        <% else %>
          <%= button_to "Take the remote", claim_hunt_presentation_path(@hunt.code.upcase), class: "btn btn-sm btn-ghost text-white" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if Flipper.enabled?(:chat) %>
    <div class="w-full shrink-0 border-t border-white/10 sm:w-80 sm:border-l sm:border-t-0">
      <%= render partial: "hunts/chat", locals: {hunt: @hunt} %>
    </div>
  <% end %>
</div>
