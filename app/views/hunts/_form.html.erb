<%= form_with model: hunt, url: hunts_path, method: :post, id: "hunt_form", data: {controller: "form"}, class: "space-y-10" do |f| %>
  <%= f.hidden_field :template, value: @hunt.name %>
  <%= f.hidden_field :timezone, data: {"form-target": "timezone"} %>

  <div>
    <%= f.label :name, "Hunt name", class: "mb-1.5 block text-sm font-semibold" %>
    <%= f.text_field :name, required: true, autocomplete: "off", class: "input input-lg w-full text-xl font-bold" %>
  </div>

  <section>
    <h2 class="text-lg font-bold">Timer</h2>
    <p class="mt-1 text-sm text-ink-soft">Optional. Without times, teams can submit photos whenever they open the list.</p>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :starts_at, "Starts", class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.datetime_local_field :starts_at, class: "input input-lg w-full", data: {"form-target": "datetime"} %>
        <p class="mt-1.5 text-xs text-ink-soft">Photos can't be submitted before this.</p>
      </div>
      <div>
        <%= f.label :ends_at, "Ends", class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.datetime_local_field :ends_at, class: "input input-lg w-full", data: {"form-target": "datetime", action: "change->form#toggleEndFields"} %>
        <p class="mt-1.5 text-xs text-ink-soft">Submissions stop at this time.</p>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-lg font-bold">Results</h2>
    <p class="mt-1 text-sm text-ink-soft">Decide who sees the leaderboard and photos, and when.</p>
    <div class="mt-4 space-y-4">
      <div class="hidden" data-form-target="endConfig">
        <%= f.label :lock_results, class: "flex cursor-pointer items-center justify-between gap-4 rounded-2xl border border-base-300 px-4 py-3" do %>
          <span>
            <span class="block font-semibold">Hide results until the hunt ends</span>
            <span class="block text-sm text-ink-soft">Nobody can peek at the leaderboard while they're still hunting.</span>
          </span>
          <%= f.check_box :lock_results, class: "toggle toggle-primary", data: {test: "lock-results-switch"} %>
        <% end %>
      </div>
      <% if Flipper.enabled?(:chat) %>
        <%= f.label :chat_enabled, class: "flex cursor-pointer items-center justify-between gap-4 rounded-2xl border border-base-300 px-4 py-3" do %>
          <span>
            <span class="block font-semibold">Party chat</span>
            <span class="block text-sm text-ink-soft">Everyone in the hunt can chat and see your announcements.</span>
          </span>
          <%= f.check_box :chat_enabled, class: "toggle toggle-primary", data: {test: "chat-switch"} %>
        <% end %>
      <% end %>
      <div>
        <%= f.label :lock_password, "Results password", class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.text_field :lock_password, class: "input input-lg w-full", autocomplete: "off", placeholder: "Optional" %>
        <p class="mt-1.5 text-xs text-ink-soft">If set, someone has to type this once before results are shown.</p>
      </div>
    </div>
  </section>

  <section>
    <h2 class="text-lg font-bold">Fair play</h2>
    <p class="mt-1 text-sm text-ink-soft">While reviewing photos, anyone can flag one that doesn't count.</p>
    <div class="mt-4">
      <%= f.label :max_downvotes_to_lose_points, "Flags needed to reject a photo", class: "mb-1.5 block text-sm font-semibold" %>
      <%= f.number_field :max_downvotes_to_lose_points, min: 1, step: 1, inputmode: "numeric", class: "input input-lg w-full sm:w-40", placeholder: "Off" %>
      <p class="mt-1.5 text-xs text-ink-soft">Leave empty to turn flagging off.</p>
    </div>
  </section>
<% end %>

<% content_for :bottom_bar do %>
  <div class="bottom-bar">
    <div class="page flex items-center gap-3 pt-3">
      <%= button_tag type: :submit, form: "hunt_form", class: "btn btn-primary btn-lg grow" do %>
        <%= icon :flag, class: "size-5" %>
        Create hunt
      <% end %>
    </div>
  </div>
<% end %>
