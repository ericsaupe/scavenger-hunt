<%= render(PageHeaderComponent.new(title: "Join a hunt", subtitle: "Type the five-letter code from your organizer, or scan their QR code.")) %>

<div class="page space-y-12">
  <%= form_with url: join_hunts_path, method: :get, data: {controller: "code"} do |form| %>
    <%= form.label :code, "Hunt code", class: "mb-1.5 block text-sm font-semibold" %>
    <%= form.text_field :code,
          value: params[:code],
          class: "code-field",
          required: true,
          maxlength: 5,
          autofocus: true,
          autocomplete: "off",
          autocapitalize: "characters",
          spellcheck: false,
          placeholder: "ABCDE",
          data: {action: "input->code#normalize"} %>
    <%= form.button class: "btn btn-primary btn-lg btn-block mt-4" do %>
      Join
      <%= icon :chevron_right, class: "size-5" %>
    <% end %>
  <% end %>

  <section data-controller="past-hunts">
    <h2 class="text-lg font-bold">Hunts you've joined</h2>
    <ul class="mt-3 -mx-5 divide-y divide-base-300 border-y border-base-300" data-past-hunts-target="list"></ul>
    <p class="mt-2 text-sm text-ink-soft" data-past-hunts-target="empty">Hunts you join on this phone show up here so you can get back in.</p>
  </section>
</div>
