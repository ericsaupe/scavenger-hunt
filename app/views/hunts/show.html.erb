<% description "Get ready to start #{@hunt.name}. Join a team or start your own and get going!" %>
<% title @hunt.name %>

<%= render(PageHeaderComponent.new(title: @hunt.name)) do %>
  <% if @hunt.timer? %>
    <div class="mt-3"><%= render partial: "timer", locals: {hunt: @hunt} %></div>
  <% end %>
<% end %>

<%= form_with url: hunt_teams_path(@hunt.code), method: :post, id: "team_form", data: {controller: "past-hunts", "past-hunts-code-value": @hunt.code, "past-hunts-name-value": @hunt.name} do |f| %>
  <div class="page">
    <h2 class="text-lg font-bold">Pick your team</h2>
    <p class="mt-1 text-sm text-ink-soft">Everyone on a team shares one list. When a teammate finds something, it ticks off for all of you.</p>
  </div>

  <%= turbo_stream_from "teams_#{@hunt.id}" %>
  <div class="mx-auto mt-4 max-w-2xl">
    <div id="teams" class="divide-y divide-base-300 border-y border-base-300">
      <%= render(@hunt.teams) %>
    </div>
    <p class="page py-3 text-sm text-ink-soft [#teams:empty+&]:block hidden">No teams yet. Start the first one below.</p>
  </div>

  <% unless @hunt.ended? %>
    <div class="page mt-8">
      <%= f.label :name, "Or start a new team", class: "mb-1.5 block text-lg font-bold" %>
      <%= f.text_field :name, class: "input input-lg w-full", placeholder: "Team name", autocomplete: "off", autocapitalize: "words" %>
      <div class="mt-3 flex items-center justify-between gap-3">
        <p class="text-sm text-ink-soft">Your team's critter. Shuffle until you like it.</p>
        <%= turbo_frame_tag "new_team_avatar" do %>
          <%= render partial: "teams/avatar_picker", locals: {hunt: @hunt, seed: Team.new_avatar_seed} %>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>

<% if PushSubscription.configured? %>
  <%= render partial: "notification_settings", locals: {hunt: @hunt} %>
<% end %>

<section class="page mt-12">
  <div class="rounded-3xl bg-base-200 p-5">
    <h2 class="text-lg font-bold">Invite others</h2>
    <p class="mt-1 text-sm text-ink-soft">They can type the code on the home page or scan this.</p>
    <div class="mt-4 flex items-center gap-5">
      <div class="shrink-0 rounded-2xl bg-white p-2">
        <svg class="qr-code size-28" aria-label="QR code for this hunt" role="img"><%= hunt_qr_code_svg(@hunt) %></svg>
      </div>
      <div class="min-w-0">
        <p class="text-xs font-semibold text-ink-soft">Hunt code</p>
        <p class="font-mono text-4xl font-extrabold tracking-[0.2em]"><%= @hunt.code.upcase %></p>
        <div class="mt-3 flex flex-wrap gap-2">
          <button type="button" class="btn btn-sm" data-controller="clipboard" data-clipboard-text-value="<%= hunt_url(@hunt.code.upcase) %>" data-action="clipboard#copy">
            <%= icon :link, class: "size-4" %>
            <span data-clipboard-target="label">Copy link</span>
          </button>
          <%= link_to hunt_print_path(@hunt.code.upcase), target: "_blank", rel: "noopener", class: "btn btn-sm" do %>
            <%= icon :printer, class: "size-4" %>
            Print list
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>

<% if @hunt.chat_available? && @hunt.organizer?(cookies[:user_id]) %>
  <%= render partial: "messages/chat", locals: {hunt: @hunt, position: "fixed right-4 bottom-24"} %>
<% end %>

<% content_for :bottom_bar do %>
  <div class="bottom-bar">
    <div class="page flex items-center gap-3 pt-3">
      <%= button_tag type: :submit, form: "team_form", class: "btn btn-primary btn-lg grow" do %>
        Join the hunt
        <%= icon :chevron_right, class: "size-5" %>
      <% end %>
      <% unless @hunt.timer? && !@hunt.ended? %>
        <%= link_to hunt_results_path(@hunt.code), class: "btn btn-lg btn-outline" do %>
          <%= icon :trophy, class: "size-5" %>
          View results
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
