<%= link_to download_results_hunt_path(@hunt.code.upcase),
      target: "_blank",
      class: "btn btn-outline",
      rel: "noopener",
      data: {
        controller: "download",
        action: "click->download#toggleDownload",
        "download-filename-value": @hunt.name.to_s
      } do %>
  <span data-download-target="icon"><%= icon :download, class: "size-5" %></span>
  <span class="loading loading-spinner loading-sm hidden" data-download-target="loadingIcon"></span>
  Download photos
<% end %>
