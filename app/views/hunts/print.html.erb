<div class="mx-auto max-w-3xl px-6 py-8 print:px-0">
  <div class="flex items-start justify-between gap-6 border-b-2 border-current pb-4">
    <div>
      <h1 class="display text-3xl"><%= @hunt.name %></h1>
      <p class="mt-2 text-lg">Code: <span class="font-mono font-bold tracking-widest"><%= @hunt.code.upcase %></span></p>
      <p class="mt-1 text-sm text-ink-soft">Join at <%= root_url %> and type the code, or scan.</p>
    </div>
    <svg class="qr-code size-28 shrink-0"><%= hunt_qr_code_svg(@hunt) %></svg>
  </div>

  <div class="mt-6 columns-2 gap-8">
    <% @hunt.categories.each do |category| %>
      <section class="mb-6 break-inside-avoid">
        <h2 class="flex items-baseline justify-between text-lg font-bold">
          <%= category.name %>
          <span class="text-sm font-semibold text-ink-soft"><%= pluralize(category.points, "point") %> each</span>
        </h2>
        <ul class="mt-2 space-y-1.5">
          <% category.items.each do |item| %>
            <li class="flex items-center gap-2">
              <span class="size-4 shrink-0 rounded-sm border-2 border-current"></span>
              <%= item.name %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>

<script>
  setTimeout(() => {
    window.print()
  }, 1000)
</script>
