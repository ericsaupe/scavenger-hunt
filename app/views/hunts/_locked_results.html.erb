<div class="page mt-4">
  <div class="rounded-3xl bg-base-200 p-6">
    <span class="grid size-12 place-items-center rounded-2xl bg-neutral text-marigold"><%= icon :lock, class: "size-6" %></span>
    <h2 class="display mt-4 text-2xl">Results are not yet available!</h2>
    <p class="mt-2 text-ink-soft">
      <% if hunt.lock_password %>
        The organizer set a password. Type it once and the results open for everyone.
      <% else %>
        Results open when the hunt ends at <%= hunt.ends_at.strftime("%l:%M %p %Z on %A, %B %e, %Y") %>.
      <% end %>
    </p>
    <% if hunt.lock_password %>
      <%= form_with url: unlock_results_hunt_path(code: hunt.code.upcase), method: :post, class: "mt-6" do |f| %>
        <%= f.label :password, "Password", class: "mb-1.5 block text-sm font-semibold" %>
        <%= f.password_field :password, required: true, class: "input input-lg w-full", autofocus: true %>
        <button class="btn btn-primary btn-lg btn-block mt-3">Unlock results</button>
      <% end %>
    <% end %>
  </div>
</div>
