<% winner = results.first %>
<% if winner.present? %>
  <div class="page mt-8" data-testid="winner">
    <figure class="polaroid-lg mx-auto max-w-sm" style="transform: rotate(-1.5deg)">
      <% if winner[:victory_photo_url] %>
        <%= image_tag winner[:victory_photo_url], class: "aspect-[4/3] w-full object-cover", alt: "" %>
      <% else %>
        <div class="grid aspect-[4/3] w-full place-items-center bg-marigold text-marigold-content"><%= icon :trophy, class: "size-16" %></div>
      <% end %>
      <figcaption class="mt-4 text-center">
        <%= team_avatar(winner[:team], size: 64, class: "mx-auto mb-2 ring-4 ring-marigold/40") %>
        <span class="block text-sm font-semibold text-ink-soft">First place</span>
        <span class="display block text-3xl text-ink"><%= winner[:name] %></span>
      </figcaption>
    </figure>
  </div>
<% end %>

<% with_deductions = results.any? { |result| result[:deductions]&.positive? } %>
<div class="page mt-10 overflow-x-auto">
  <table class="table">
    <thead>
      <tr class="text-ink-soft">
        <th class="w-10"></th>
        <th>Name</th>
        <th class="text-right">Submissions</th>
        <% if with_deductions %>
          <th class="text-right">Total Score</th>
          <th class="text-right">Deductions</th>
          <th class="text-right">Final Score</th>
        <% else %>
          <th class="text-right">Score</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% results.each_with_index do |result, i| %>
        <tr class="<%= "bg-marigold/15 text-lg font-bold" if i.zero? %>">
          <td class="tabular-nums text-ink-soft">
            <% if i.zero? %>
              <%= icon :trophy, class: "size-5 text-ink" %>
            <% else %>
              <%= i + 1 %>
            <% end %>
          </td>
          <td class="font-semibold">
            <span class="flex items-center gap-2.5">
              <%= team_avatar(result[:team], size: 32) %>
              <span><%= result[:name] %></span>
            </span>
          </td>
          <td class="text-right tabular-nums"><%= result[:submissions] %></td>
          <% if with_deductions %>
            <td class="text-right tabular-nums"><%= result[:total_score] %></td>
            <td class="text-right tabular-nums text-error"><%= result[:deductions].to_i * -1 %></td>
            <td class="text-right tabular-nums"><%= result[:score] %></td>
          <% else %>
            <td class="text-right tabular-nums"><%= result[:score] %></td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
