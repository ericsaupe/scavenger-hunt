<%= turbo_stream_from "hunts_chat_#{hunt.id}" %>

<div class="flex h-[60dvh] flex-col sm:h-full" data-controller="chat" data-action="turbo:submit-end->chat#reset">
  <div id="hunt_chat_<%= hunt.id %>" class="chat-container grow overflow-y-auto p-3">
    <%= render hunt.messages %>
  </div>
  <%= form_for Message.new(hunt: hunt), url: hunt_messages_path(hunt.code.upcase), method: :post do |f| %>
    <div class="flex items-center gap-2 border-t border-white/10 p-3">
      <%= image_tag "https://api.dicebear.com/7.x/fun-emoji/svg?seed=#{cookies[:user_id]}", class: "size-9 rounded-lg", alt: "" %>
      <%= f.text_field :content, class: "input grow bg-white/10 text-white placeholder:text-white/50", placeholder: "Say something", autocomplete: "off" %>
      <%= f.button class: "btn btn-circle btn-primary", "aria-label": "Send" do %>
        <%= icon :send, class: "size-5" %>
      <% end %>
    </div>
  <% end %>
</div>
