<% description "Results for the scavenger hunt #{@hunt.name}." %>
<% title "#{@hunt.name} Results" %>

<%= render(PageHeaderComponent.new(
      title: "#{@hunt.name} results",
      subtitle: ("Let's see how everyone did!" unless @hunt.results_locked?),
      back_to: hunt_path(@hunt.code),
      back_label: "Hunt"
    )) %>

<% if @hunt.results_locked? %>
  <%= render partial: "locked_results", locals: {hunt: @hunt} %>
<% else %>
  <div class="page flex flex-wrap gap-2">
    <%= link_to(hunt_presenter_path(@hunt.code.upcase, screen: "big"), class: "btn btn-primary", data: {turbo_prefetch: false}) do %>
      <%= icon :tv, class: "size-5" %>
      Present on a big screen
    <% end %>
    <%= link_to(hunt_presenter_path(@hunt.code.upcase), class: "btn", data: {turbo_prefetch: false}) do %>
      <%= icon :video, class: "size-5" %>
      Watch along
    <% end %>
    <%= render partial: "download_button" %>
  </div>

  <% if @hunt.in_grace_window? %>
    <div data-controller="live" data-live-interval-value="30000" data-testid="grace-window">
      <% if (pending = @hunt.pending_upload_count).positive? %>
        <div class="page mt-6">
          <div class="flex items-start gap-3 rounded-2xl bg-base-200 px-4 py-3 text-sm" role="status" data-testid="pending-uploads">
            <%= icon :cloud, class: "mt-0.5 size-5 shrink-0 text-ink-soft" %>
            <span><strong><%= pluralize(pending, "photo") %> still uploading</strong> from teams with poor signal. Results update as they land.</span>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <% unless @hunt.leaderboard_visible? %>
    <%= render(partial: "hunts/locked_leaderboard", locals: {hunt: @hunt}) %>
  <% else %>
    <%= render(partial: "hunts/leaderboard", locals: {results: @results}) %>
  <% end %>

  <div class="page mt-12">
    <h2 class="display text-2xl">Every item</h2>
    <p class="mt-1 text-sm text-ink-soft">Tap a found item to see each team's photo and vote on it.</p>
  </div>
  <%= render partial: "hunts/results_items" %>

  <p class="page mt-12 text-center text-xs text-ink-soft" data-testid="avatar-credit">Team and chat avatars by <a href="https://www.dicebear.com" class="link" target="_blank" rel="noopener">DiceBear</a>, in the Critters and Thumbs styles (CC0).</p>
<% end %>
