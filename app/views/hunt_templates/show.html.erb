<% title "#{@template.name} list" %>
<% description @template.description %>

<div class="page pt-6">
  <%= link_to hunts_path, class: "inline-flex items-center gap-1 text-sm font-semibold text-ink-soft hover:text-ink" do %>
    <%= icon :arrow_left, class: "size-4" %>
    All lists
  <% end %>
  <%= image_tag(asset_path(@template.image_path), class: "mt-4 aspect-[2/1] w-full rounded-3xl object-cover sm:aspect-[5/2]", alt: "") %>
</div>

<%= render(PageHeaderComponent.new(title: @template.name, subtitle: @template.description)) do %>
  <dl class="mt-5 flex flex-wrap gap-x-7 gap-y-3">
    <% {"Items" => @template.item_count, "Groups" => @template.categories.size, "Points" => template_points_each(@template), "Possible score" => @template.possible_score}.each do |label, value| %>
      <div>
        <dt class="text-[11px] font-bold uppercase tracking-[0.1em] text-ink-soft"><%= label %></dt>
        <dd class="mt-0.5 text-xl font-extrabold tabular-nums"><%= value %></dd>
      </div>
    <% end %>
  </dl>
  <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2">
    <%= link_to new_hunt_path(template: @template.name), class: "btn btn-primary btn-lg rounded-full" do %>
      <%= icon :flag, class: "size-5" %>
      Use this list
    <% end %>
    <span class="text-sm text-ink-soft">Nothing is created until you finish set-up.</span>
  </div>
<% end %>

<div class="page">
  <section>
    <h2 class="text-xs font-bold uppercase tracking-[0.12em] text-ink-soft">How points work</h2>
    <ul class="mt-2.5 flex flex-wrap gap-2">
      <% @template.categories.each do |category| %>
        <li class="inline-flex items-center gap-2 rounded-full bg-base-200 py-1 pl-3.5 pr-1.5 text-sm font-bold">
          <%= category.name %>
          <span class="rounded-full bg-neutral px-2 py-0.5 text-xs tabular-nums text-neutral-content"><%= pluralize(category.points, "pt") %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-2xl font-extrabold">Everything on the list</h2>
    <div class="mt-3 sm:columns-2 sm:gap-4">
      <% @template.categories.each do |category| %>
        <% wide = category.items.size > 15 %>
        <section class="mb-4 break-inside-avoid rounded-2xl border border-base-300 px-4 py-3.5 <%= "sm:[column-span:all]" if wide %>" data-testid="group">
          <h3 class="flex flex-wrap items-baseline justify-between gap-x-3 font-bold">
            <%= category.name %>
            <span class="text-xs font-bold text-primary"><%= pluralize(category.points, "pt") %> each · <%= pluralize(category.items.size, "item") %></span>
          </h3>
          <ul class="mt-2.5 space-y-1.5 <%= "sm:columns-2 sm:gap-6" if wide %>">
            <% category.items.each do |item| %>
              <li class="flex items-start gap-2.5 break-inside-avoid text-sm leading-snug">
                <span class="mt-0.5 size-4 shrink-0 rounded-sm border-2 border-base-300"></span>
                <%= item %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </section>
</div>

<% content_for :bottom_bar do %>
  <div class="bottom-bar">
    <div class="page flex items-center gap-3 pt-3">
      <p class="hidden grow text-sm sm:block"><strong>Like it?</strong> <span class="text-ink-soft">Set-up takes under a minute: name, timer, go.</span></p>
      <%= link_to new_hunt_path(template: @template.name), class: "btn btn-primary btn-lg grow rounded-full sm:grow-0" do %>
        <%= icon :flag, class: "size-5" %>
        Use this list
      <% end %>
    </div>
  </div>
<% end %>
