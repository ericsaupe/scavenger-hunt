<% title "#{@hunt.name} remote" %>
<%= render partial: "hunts/presenter_head" %>

<%= tag.div class: class_names("mx-auto flex min-h-dvh w-full max-w-md flex-col gap-6 px-5 pt-4", @hunt.chat_available? ? "pb-[calc(4.5rem_+_max(1rem,env(safe-area-inset-bottom)))]" : "pb-[max(1.5rem,env(safe-area-inset-bottom))]"), data: remote_data(@hunt, @slide) do %>
  <%= turbo_stream_from @hunt.presenter_stream, id: "presenter_stream", data: {turbo_permanent: true} %>

  <div class="flex items-center justify-between">
    <%= link_to hunt_results_path(@hunt.code.upcase), class: "btn btn-ghost btn-sm text-white/70 hover:text-white" do %>
      <%= icon :arrow_left, class: "size-4" %>
      Results
    <% end %>
    <%= link_to hunt_presenter_path(@hunt.code.upcase, screen: "big"), target: "_blank", rel: "noopener", class: "btn btn-ghost btn-sm text-white/70 hover:text-white" do %>
      <%= icon :tv, class: "size-4" %>
      Open the big screen
    <% end %>
  </div>

  <div class="flex items-center gap-4">
    <figure class="polaroid w-24 shrink-0" style="--tilt: -2deg">
      <div class="grid aspect-square place-items-center overflow-hidden bg-black">
        <% if (submission = @slide.submission) %>
          <% if submission.video? %>
            <% if (poster = submission.poster_url(:small)) %>
              <%= image_tag poster, class: "size-full object-cover", alt: "" %>
            <% else %>
              <%= icon :video, class: "size-8 text-white/70" %>
            <% end %>
          <% else %>
            <%= image_tag submission_attachment_url(submission), class: "size-full object-cover", alt: "" %>
          <% end %>
        <% elsif @slide.is_a?(Presentation::Finale) && @slide.sealed? %>
          <span class="grid size-full place-items-center bg-[#f3e9d2] text-flag-content"><%= icon :lock, class: "size-8" %></span>
        <% elsif @slide.is_a?(Presentation::Finale) %>
          <span class="grid size-full place-items-center bg-flag text-flag-content"><%= icon :trophy, class: "size-8" %></span>
        <% else %>
          <span class="grid size-full place-items-center bg-[#1b1f24] text-flag"><%= icon :flag, solid: true, class: "size-8" %></span>
        <% end %>
      </div>
    </figure>
    <div class="min-w-0">
      <p class="text-sm font-semibold text-white/60" data-testid="progress"><%= @slide.label %> <%= @slide.position %> of <%= @slide.count %></p>
      <p class="display mt-1 truncate text-2xl" data-testid="current-item"><%= @slide.title %></p>
      <p class="mt-1 flex items-center gap-1.5 font-semibold <%= (@slide.is_a?(Presentation::Finale) && @slide.sealed?) ? "text-flag" : "text-white/70" %>">
        <% if @slide.team %>
          <%= team_avatar(@slide.team, size: 20) %>
        <% elsif @slide.is_a?(Presentation::Finale) && @slide.sealed? %>
          <%= icon :lock, class: "size-4" %>
        <% end %>
        <span class="truncate"><%= @slide.subtitle %></span>
      </p>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <button type="button" class="btn btn-lg bg-white/10 text-white hover:bg-white/20" data-action="remote#previous" data-remote-target="button">
      <%= icon :chevron_left, class: "size-5" %>
      Previous
    </button>
    <button type="button" class="btn btn-lg btn-primary" data-action="remote#next" data-remote-target="button">
      Next
      <%= icon :chevron_right, class: "size-5" %>
    </button>
  </div>

  <% if @slide.is_a?(Presentation::Finale) && @slide.sealed? %>
    <div class="rounded-3xl border-[1.5px] border-flag/50 bg-white/5 p-4" data-testid="reveal-panel">
      <p class="text-sm font-semibold text-white/60">The big screen is showing a sealed envelope</p>
      <% if @hunt.time_locked? %>
        <p class="mt-2 leading-snug">Results open at <%= @hunt.ends_at.strftime("%l:%M %p %Z").strip %>, when the hunt ends. Until then the envelope stays sealed.</p>
      <% else %>
        <p class="mt-2 leading-snug">When everyone is watching, reveal the winners. Scores open on the results page at the same time.</p>
        <button type="button" class="btn btn-lg btn-block mt-3 border-0 bg-flag text-flag-content hover:bg-flag/90" data-action="remote#openReveal" data-remote-target="button" data-testid="reveal">
          <%= icon :trophy, class: "size-5" %>
          Reveal the winners
        </button>
      <% end %>
    </div>

    <% unless @hunt.time_locked? %>
      <% leader, runner_up = @slide.results.first(2) %>
      <dialog class="modal modal-bottom sm:modal-middle" data-remote-target="reveal" data-testid="reveal-sheet">
        <div class="modal-box bg-[#1b1f24] text-white sm:max-w-md">
          <h3 class="display text-2xl">Reveal the winners?</h3>
          <% if leader %>
            <div class="mt-4 flex items-center gap-3 rounded-2xl bg-white/5 px-3.5 py-3">
              <%= team_avatar(leader[:team], size: 44) %>
              <div class="min-w-0">
                <p class="truncate font-extrabold"><%= leader[:name] %>, <%= pluralize(leader[:score], "point") %></p>
                <% if runner_up %>
                  <% lead = leader[:score] - runner_up[:score] %>
                  <p class="truncate text-sm text-white/60"><%= lead.zero? ? "Tied with #{runner_up[:name]}" : "#{pluralize(lead, "point")} ahead of #{runner_up[:name]}" %></p>
                <% end %>
              </div>
            </div>
          <% end %>
          <p class="mt-4 text-sm leading-snug text-white/60">Only you can see this. Revealing opens the scores on the big screen, on every phone watching, and on the results page.</p>
          <button type="button" class="btn btn-lg btn-block mt-4 border-0 bg-flag text-flag-content hover:bg-flag/90" data-action="remote#reveal" data-remote-target="button" data-testid="reveal-now">Reveal now</button>
          <button type="button" class="btn btn-ghost btn-block mt-2 text-white/80" data-action="remote#closeReveal">Not yet</button>
        </div>
        <form method="dialog" class="modal-backdrop"><button type="submit" aria-label="Close">close</button></form>
      </dialog>
    <% end %>
  <% end %>

  <% if @slide.video? %>
    <div class="rounded-3xl bg-white/5 p-4">
      <p class="mb-3 text-sm font-semibold text-white/60">Video on the big screen</p>
      <div class="grid gap-3">
        <% if @hunt.playing? %>
          <button type="button" class="btn btn-lg btn-block bg-white text-[#1b1f24]" data-action="remote#pause" data-remote-target="button" data-testid="pause">Pause</button>
        <% else %>
          <button type="button" class="btn btn-lg btn-block bg-white text-[#1b1f24]" data-action="remote#play" data-remote-target="button" data-testid="play">
            <%= icon :play, solid: true, class: "size-5" %>
            Play on the big screen
          </button>
        <% end %>
        <div class="grid grid-cols-2 gap-3">
          <button type="button" class="btn bg-white/10 text-white hover:bg-white/20" data-action="remote#replay" data-remote-target="button" data-testid="replay">
            <%= icon :retake, class: "size-5" %>
            Replay
          </button>
          <% if @hunt.presentation_muted %>
            <button type="button" class="btn bg-white/10 text-white hover:bg-white/20" data-action="remote#unmute" data-remote-target="button" data-testid="sound">Sound on</button>
          <% else %>
            <button type="button" class="btn bg-white/10 text-white hover:bg-white/20" data-action="remote#mute" data-remote-target="button" data-testid="sound">Sound off</button>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <% if @hunt.chat_available? %>
    <div class="rounded-3xl bg-white/5 p-4">
      <p class="mb-1 text-sm font-semibold text-white/60">Big screen</p>
      <label class="flex min-h-12 items-center justify-between gap-4">
        <span class="font-semibold">Show the chat</span>
        <%= tag.input type: "checkbox", class: "toggle toggle-lg toggle-flag", checked: !@hunt.screen_chat_off?, data: {action: "remote#screenChat", on: "all", off: "off", testid: "screen-chat-switch"} %>
      </label>
      <label class="flex min-h-12 items-center justify-between gap-4 <%= "opacity-50" if @hunt.screen_chat_off? %>">
        <span class="font-semibold">Announcements only</span>
        <%= tag.input type: "checkbox", class: "toggle toggle-lg toggle-flag", checked: @hunt.screen_chat_announcements?, disabled: @hunt.screen_chat_off?, data: {action: "remote#screenChat", on: "announcements", off: "all", testid: "announcements-only-switch"} %>
      </label>
    </div>
  <% end %>

  <%= render partial: "presentations/up_next", locals: {presentation: @presentation} %>

  <p class="text-center text-xs text-white/40">Arrow keys change the slide. Space plays and pauses.</p>
<% end %>

<% if @hunt.chat_available? %>
  <%= render partial: "messages/chat", locals: {hunt: @hunt, position: "fixed right-4 bottom-[max(1rem,env(safe-area-inset-bottom))]"} %>
<% end %>
