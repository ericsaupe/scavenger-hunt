<% if slide.sealed? %>
  <div id="current_slide" class="relative flex grow flex-col items-center justify-center overflow-hidden px-6 pb-6 pt-16 sm:px-10 sm:py-10" data-testid="finale">
    <div class="pointer-events-none absolute inset-0 opacity-40" aria-hidden="true" data-testid="confetti"><%= static_confetti %></div>
    <div id="finale_sealed_card" class="relative z-10 flex w-full max-w-6xl flex-col items-center gap-10 @3xl:flex-row @3xl:justify-center @5xl:gap-16" style="--tilt: 0deg" data-print data-testid="sealed-finale">
      <div class="min-w-0 max-w-2xl text-center @3xl:text-left">
        <p class="text-sm font-extrabold uppercase tracking-[0.3em] text-flag @2xl:text-lg">First place</p>
        <h2 class="display mt-4 text-5xl text-white @2xl:text-6xl @5xl:text-8xl">And the winner is&hellip;</h2>
        <p class="mt-4 text-xl font-semibold text-white/70 @2xl:text-2xl">Scores are sealed. The organizer opens them from the remote.</p>
      </div>
      <figure class="polaroid-lg w-full max-w-sm shrink-0 pb-5! @3xl:max-w-xs @5xl:max-w-sm" style="transform: rotate(3deg)">
        <div class="relative grid aspect-[4/3] place-items-center overflow-hidden border border-[#e3d6b8] bg-[#f3e9d2]">
          <div class="absolute inset-0 bg-gradient-to-br from-white/40 to-transparent to-55%" aria-hidden="true"></div>
          <svg class="absolute inset-0 size-full text-[#c9b98c]" viewBox="0 0 300 225" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M12 36h276v152H12z" />
            <path d="M12 36l138 96 138-96" />
          </svg>
          <span class="relative grid size-20 place-items-center rounded-full bg-flag text-flag-content shadow-[0_8px_20px_-6px_rgba(0,0,0,0.4)] @5xl:size-24"><%= icon :lock, class: "size-10 @5xl:size-12" %></span>
        </div>
        <figcaption class="mt-4 px-1">
          <p class="text-sm font-semibold text-ink-soft">Sealed</p>
          <p class="display text-2xl text-ink">Final scores</p>
          <p class="font-semibold text-ink-soft"><%= pluralize(slide.team_count, "team") %>, <%= pluralize(slide.find_count, "find") %></p>
        </figcaption>
      </figure>
    </div>
  </div>
<% else %>
<% winner = slide.winner %>
<div id="current_slide" class="relative flex grow flex-col items-center justify-center overflow-hidden px-6 pb-6 pt-16 sm:px-10 sm:py-10" data-testid="finale">
  <div class="pointer-events-none absolute inset-0" aria-hidden="true" data-testid="confetti"><%= static_confetti %></div>
  <div id="finale_card" class="relative z-10 flex w-full max-w-6xl flex-col items-center gap-10 @3xl:flex-row @3xl:justify-center @5xl:gap-16" style="--tilt: 0deg" data-print data-controller="finale">
    <div class="min-w-0 text-center @3xl:text-left">
      <%= team_avatar(winner[:team], size: 160, class: "mx-auto mb-6 size-28 ring-4 ring-white/20 @3xl:mx-0 @5xl:size-40") %>
      <p class="text-sm font-extrabold uppercase tracking-[0.3em] text-flag @2xl:text-lg">First place</p>
      <h2 class="display mt-4 text-5xl text-white @2xl:text-6xl @5xl:text-8xl" data-testid="winner-name"><%= winner[:name] %></h2>
      <p class="mt-4 text-2xl font-extrabold text-white/80 @2xl:text-3xl @5xl:text-4xl"><%= pluralize(winner[:score], "point") %></p>
      <% if slide.runners_up.any? %>
        <ol class="mt-8 space-y-2 text-lg font-semibold text-white/70 @2xl:text-xl @5xl:text-2xl" data-testid="runners-up">
          <% slide.runners_up.each_with_index do |result, i| %>
            <li class="flex items-center justify-center gap-4 @3xl:justify-start">
              <span class="w-8 shrink-0 text-right tabular-nums text-white/40"><%= i + 2 %></span>
              <%= team_avatar(result[:team], size: 32) %>
              <span class="min-w-0 truncate text-white"><%= result[:name] %></span>
              <span class="shrink-0 tabular-nums"><%= pluralize(result[:score], "point") %></span>
            </li>
          <% end %>
        </ol>
      <% end %>
    </div>
    <% if slide.most_loved %>
      <figure class="polaroid-lg w-full max-w-sm shrink-0 pb-5! @3xl:max-w-xs @5xl:max-w-sm" style="transform: rotate(2deg)" data-testid="most-loved">
        <div class="grid aspect-[4/3] place-items-center overflow-hidden bg-black">
          <% if slide.most_loved.video? %>
            <% if (poster = slide.most_loved.poster_url(:small)) %>
              <%= image_tag poster, class: "size-full object-cover", alt: "" %>
            <% else %>
              <%= icon :play, solid: true, class: "size-16 text-white/80" %>
            <% end %>
          <% else %>
            <%= image_tag submission_attachment_url(slide.most_loved, variant_size: :large), class: "size-full object-cover", alt: "#{slide.most_loved.team.name} found #{slide.most_loved.item.name}" %>
          <% end %>
        </div>
        <figcaption class="mt-4 flex items-end justify-between gap-4 px-1">
          <div class="min-w-0">
            <p class="text-sm font-semibold text-ink-soft">Most loved</p>
            <p class="display truncate text-2xl text-ink"><%= slide.most_loved.item.name %></p>
            <p class="truncate font-semibold text-ink-soft"><%= slide.most_loved.team.name %></p>
          </div>
          <span class="inline-flex shrink-0 items-center gap-1.5 text-xl font-extrabold tabular-nums text-love">
            <%= icon :heart, solid: true, class: "size-6" %>
            <%= pluralize(slide.love_count, "love") %>
          </span>
        </figcaption>
      </figure>
    <% end %>
  </div>
</div>
<% end %>
