<div id="current_submission" class="flex grow flex-col items-center justify-center px-4 pb-24 pt-14 sm:px-10 sm:py-10">
  <figure class="polaroid-lg w-full max-w-md pb-5! sm:w-auto sm:max-w-[min(92vw,calc((100dvh-10rem)*0.9))]" style="transform: rotate(-0.75deg)">
    <% image_url = submission_attachment_url(submission, variant_size: :large) %>
    <div class="grid place-items-center overflow-hidden bg-black">
      <% if submission.video? %>
        <%= video_tag(image_url, controls: true, playsinline: true, autoplay: true, class: "max-h-[64dvh] w-full") %>
      <% else %>
        <%= image_tag(image_url, class: "max-h-[64dvh] w-full object-contain", alt: "#{submission.team.name} found #{submission.item.name}") %>
      <% end %>
    </div>
    <figcaption class="mt-4 flex flex-wrap items-end justify-between gap-x-6 gap-y-3 px-1">
      <div class="min-w-0 grow basis-48">
        <p class="display text-3xl text-ink sm:text-4xl"><%= submission.item.name %></p>
        <p class="mt-1 text-lg font-semibold text-ink-soft"><%= submission.team.name %></p>
      </div>
      <%= turbo_frame_tag "vote_menu", src: submission_vote_menu_path(submission), class: "shrink-0" %>
    </figcaption>
  </figure>
</div>
