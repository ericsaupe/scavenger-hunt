<dialog class="modal modal-bottom sm:modal-middle" data-hunt-target="modal">
  <div class="modal-box max-h-[92dvh] overflow-hidden p-0 sm:max-w-xl">
    <div class="grid max-h-[65dvh] min-h-56 place-items-center bg-black" data-hunt-target="content"></div>
    <div class="p-5">
      <h3 class="text-xl font-bold" data-hunt-target="title"></h3>
      <div class="mt-4 flex gap-2">
        <%= tag.button type: "button", class: "btn btn-lg btn-outline grow", hidden: !@hunt.in_progress?, data: {action: "hunt#retake", timer_while: "open reopened"} do %>
          <%= icon :retake, class: "size-5" %>
          Retake
        <% end %>
        <button type="button" class="btn btn-lg btn-primary grow" data-action="hunt#closeModal">Done</button>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button type="submit" aria-label="Close">close</button></form>
</dialog>
