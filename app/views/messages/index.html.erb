<% if @before %>
  <%= turbo_frame_tag "chat_earlier_#{@before}", class: "block" do %>
    <% if @more %>
      <%= render partial: "messages/earlier", locals: {hunt: @hunt, before: @messages.first.id} %>
    <% end %>
    <div class="mb-3 space-y-3">
      <%= render partial: "messages/message", collection: @messages, locals: {viewer_id: cookies[:user_id]} %>
    </div>
  <% end %>
<% else %>
  <%= turbo_frame_tag "chat_messages_#{@hunt.id}", class: "block" do %>
    <%= render partial: "messages/list", locals: {hunt: @hunt, messages: @messages, more: @more} %>
  <% end %>
<% end %>
