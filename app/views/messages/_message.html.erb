<div class="chat chat-start" data-controller="message">
  <div class="chat-image avatar">
    <div class="w-9 rounded-lg">
      <%= image_tag "https://api.dicebear.com/7.x/fun-emoji/svg?seed=#{message.user_id}", alt: "" %>
    </div>
  </div>
  <div class="chat-bubble bg-white/10 text-white"><%= message.content %></div>
</div>
