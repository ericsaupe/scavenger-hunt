<div id="organizer_card_<%= hunt.id %>" data-testid="organizer-card">
  <% if message %>
    <div class="page mt-5">
      <div class="rounded-2xl bg-neutral px-4 py-3 text-neutral-content">
        <p class="flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide text-marigold"><%= icon :megaphone, class: "size-4" %>From the organizer</p>
        <p class="mt-1 text-[15px] leading-snug"><%= message.content %></p>
        <p class="mt-1 text-xs text-neutral-content/70"><%= message.sender_name %>, <time datetime="<%= message.created_at.iso8601 %>" data-chat-time><%= message.created_at.strftime("%-l:%M") %></time></p>
      </div>
    </div>
  <% end %>
</div>
