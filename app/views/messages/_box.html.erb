<% messages = hunt.recent_messages %>
<%= tag.div class: "contents", data: {chat_box: "", chat_organizer: ("" if hunt.owner?(cookies[:user_id]))}.compact do %>
  <div class="shrink-0 border-b border-base-300 px-5 pb-3 pt-2">
    <div class="mx-auto mb-3 h-1.5 w-10 cursor-grab touch-none rounded-full bg-base-300 sm:hidden" data-action="pointerdown->chat#dragStart pointermove->chat#dragMove pointerup->chat#dragEnd pointercancel->chat#dragEnd" aria-hidden="true"></div>
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h2 id="party_chat_title_<%= hunt.id %>" class="display text-2xl">Party chat</h2>
        <p class="mt-0.5 text-sm text-ink-soft">Everyone in the hunt, <span id="<%= hunt.chat_team_count_id %>"><%= render partial: "messages/team_count", locals: {hunt:} %></span></p>
      </div>
      <button type="button" class="btn btn-ghost btn-sm btn-circle shrink-0" data-action="chat#close" aria-label="Close chat"><%= icon :x_mark, class: "size-5" %></button>
    </div>
  </div>
  <%= render partial: "messages/pinned", locals: {hunt:, message: hunt.latest_announcement} %>
  <div class="grow overflow-y-auto overscroll-contain px-4 py-3" data-chat-target="scroller" data-action="scroll->chat#scrolled">
    <%= render partial: "messages/list", locals: {hunt:, messages:, more: messages.any? && hunt.earlier_messages?(messages.first)} %>
  </div>
  <%= render partial: "messages/composer", locals: {hunt:, name: chat_name} %>
<% end %>
