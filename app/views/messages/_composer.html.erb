<% team = chat_team(hunt) %>
<div id="<%= hunt.chat_composer_id %>" class="shrink-0 border-t border-base-300 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] pt-3" data-chat-target="composer">
  <p id="<%= hunt.chat_notice_id %>" class="mb-2 text-xs font-semibold text-error empty:hidden" role="status" aria-live="polite"><%= local_assigns[:error] %></p>

  <%= form_with url: hunt_chat_name_path(hunt.code), method: :patch, class: ("hidden" if name.present?), data: {chat_target: "nameForm", action: "submit->chat#nameSubmitted"} do |f| %>
    <%= f.label :name, "What should we call you?", class: "block text-sm font-bold", for: "chat_name_#{hunt.id}" %>
    <p class="mt-0.5 text-xs text-ink-soft">Shown with your team next to everything you send.</p>
    <div class="mt-2 flex gap-2">
      <%= f.text_field :name, id: "chat_name_#{hunt.id}", value: name, maxlength: Message::MAX_NAME_LENGTH, required: true, autocomplete: "nickname", autocapitalize: "words", placeholder: "Your name", class: "input grow", data: {chat_target: "nameInput"} %>
      <button class="btn btn-primary">Save</button>
    </div>
  <% end %>

  <%= form_with model: hunt.messages.new, url: hunt_messages_path(hunt.code), class: ("hidden" if name.blank?), data: {chat_target: "form", action: "turbo:submit-end->chat#sent"} do |f| %>
    <div class="flex items-center gap-2">
      <%= f.text_field :content, maxlength: Message::MAX_CONTENT_LENGTH, required: true, autocomplete: "off", enterkeyhint: "send", placeholder: "Say something to everyone", "aria-label": "Message", class: "input grow", data: {chat_target: "input", action: "input->chat#count"} %>
      <%= f.button class: "btn btn-circle btn-primary", title: "Send", "aria-label": "Send" do %>
        <%= icon :send, class: "size-5" %>
      <% end %>
    </div>
    <p class="mt-1.5 flex items-center justify-between gap-3 text-xs text-ink-soft">
      <span class="min-w-0 truncate">Sending as <strong class="text-ink"><%= name %></strong><% if team %>, <%= team.name %><% end %></span>
      <span class="flex shrink-0 items-center gap-2">
        <span class="tabular-nums" data-chat-target="counter" data-testid="chat-counter">0/<%= Message::MAX_CONTENT_LENGTH %></span>
        <button type="button" class="link font-semibold" data-action="chat#editName">Change name</button>
      </span>
    </p>
  <% end %>
</div>
