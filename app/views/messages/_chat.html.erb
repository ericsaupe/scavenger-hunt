<% offset = local_assigns.fetch(:offset, "bottom-4") %>
<%= tag.div id: "party_chat_#{hunt.id}", class: "contents", data: {turbo_permanent: true, controller: "chat", chat_hunt_id_value: hunt.id, chat_viewer_value: hunt.viewer_token(cookies[:user_id]), chat_url_value: hunt_messages_path(hunt.code), chat_max_value: Message::MAX_CONTENT_LENGTH} do %>
  <%= turbo_stream_from hunt.chat_stream %>

  <button type="button" class="fixed right-4 z-40 inline-flex items-center gap-2 rounded-full bg-neutral py-2.5 pl-3.5 pr-4 text-sm font-bold text-neutral-content shadow-lg ring-1 ring-base-content/10 transition active:scale-95 <%= offset %>" data-action="chat#show" data-chat-target="pill" data-testid="chat-pill" aria-haspopup="dialog" aria-controls="party_chat_sheet_<%= hunt.id %>">
    <%= icon :chat_bubble, class: "size-5 text-marigold" %>
    Party chat
    <span class="grid h-5 min-w-5 place-items-center rounded-full bg-marigold px-1.5 text-xs font-extrabold tabular-nums text-marigold-content" data-chat-target="badge" data-testid="chat-unread" hidden></span>
  </button>

  <div id="party_chat_sheet_<%= hunt.id %>" class="modal modal-bottom sm:modal-middle" role="dialog" aria-modal="true" aria-labelledby="party_chat_title_<%= hunt.id %>" data-chat-target="sheet" data-testid="chat-sheet">
    <div class="modal-box flex h-[85dvh] max-h-[85dvh] flex-col p-0 sm:h-[36rem] sm:max-w-lg" data-chat-target="box">
      <%= turbo_frame_tag "chat_box_#{hunt.id}", src: hunt_messages_path(hunt.code), class: "flex min-h-0 grow flex-col", data: {chat_target: "frame", chat_organizer: ("" if hunt.owner?(cookies[:user_id]))}.compact %>
    </div>
    <button type="button" class="modal-backdrop" data-action="chat#close" aria-label="Close chat">close</button>
  </div>
<% end %>
