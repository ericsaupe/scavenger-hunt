<% if submissions.empty? %>
  <div class="page">
    <div class="rounded-3xl bg-base-200 p-6 text-center">
      <%= image_tag "nothing.png", class: "mx-auto w-40 rounded-2xl", alt: "" %>
      <h3 class="display mt-4 text-2xl">Nobody found this one.</h3>
    </div>
  </div>
<% else %>
  <div id="items" class="carousel w-full snap-x snap-mandatory gap-4 px-5 sm:gap-8">
    <% submissions.each do |submission| %>
      <div id="submission_<%= submission.id %>" class="carousel-item w-full snap-center justify-center">
        <figure class="polaroid-lg w-full max-w-md pb-5!" style="transform: rotate(0)">
          <% image_url = submission_attachment_url(submission, variant_size: :large) %>
          <div class="grid min-h-48 place-items-center overflow-hidden bg-black">
            <% if submission.video? %>
              <%= video_tag(image_url, controls: true, playsinline: true, preload: "metadata", class: "max-h-[60dvh] w-full") %>
            <% else %>
              <%= image_tag(image_url, class: "max-h-[60dvh] w-full object-contain", alt: "#{submission.team.name} found #{submission.item.name}") %>
            <% end %>
          </div>
          <figcaption class="mt-4 flex items-center justify-between gap-3">
            <span class="display min-w-0 truncate text-2xl text-ink"><%= submission.team.name %></span>
            <%= render(partial: "items/vote_menu", locals: {
                  vote: submission.votes.find_or_initialize_by(submission_id: submission.id, user_id: cookies[:user_id])
                }) %>
          </figcaption>
        </figure>
      </div>
    <% end %>
  </div>

  <% if submissions.size > 1 %>
    <div id="pages" class="mt-5 flex justify-center gap-2">
      <% submissions.each_with_index do |submission, i| %>
        <a href="#submission_<%= submission.id %>" class="btn btn-circle btn-sm" aria-label="Show submission <%= i + 1 %>"><%= i + 1 %></a>
      <% end %>
    </div>
  <% end %>
<% end %>

<% content_for :bottom_bar do %>
  <div class="bottom-bar">
    <div class="page grid grid-cols-2 gap-3 pt-3">
      <%= link_to hunt_item_path(hunt.code, previous_item), class: "btn btn-lg btn-outline h-auto justify-start gap-2 overflow-hidden py-2" do %>
        <%= icon :chevron_left, class: "size-5 shrink-0" %>
        <span class="min-w-0 text-left">
          <span class="block text-xs font-semibold text-ink-soft">Previous</span>
          <span class="block truncate"><%= previous_item.name %></span>
        </span>
      <% end %>
      <%= link_to hunt_item_path(hunt.code, next_item), class: "btn btn-lg btn-outline h-auto justify-end gap-2 overflow-hidden py-2" do %>
        <span class="min-w-0 text-right">
          <span class="block text-xs font-semibold text-ink-soft">Next</span>
          <span class="block truncate"><%= next_item.name %></span>
        </span>
        <%= icon :chevron_right, class: "size-5 shrink-0" %>
      <% end %>
    </div>
  </div>
<% end %>
