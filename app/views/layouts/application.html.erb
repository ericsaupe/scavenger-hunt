<!DOCTYPE html>
<html lang="en" data-theme="<%= daisy_theme %>">
  <head>
    <%= display_meta_tags(
          site: "Scavenger Hunt Party!",
          og: {
            image: image_url("logo.png")
          }
        ) %>
    <% keywords "Photo Scavenger Hunt, Scavenger Hunt" %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="<%= @presenter_mode ? "#111317" : "#ffffff" %>">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#15181c">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&display=swap">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%= render partial: "shared/head" %>
  </head>

  <body class="min-h-dvh font-sans antialiased <%= @presenter_mode ? "stage" : "bg-base-100 text-base-content" %>">
    <% unless @presenter_mode %>
      <header class="sticky top-0 z-30 border-b border-base-300 bg-base-100/90 backdrop-blur">
        <div class="mx-auto flex h-14 max-w-5xl items-center justify-between px-5">
          <%= link_to root_path, class: "flex min-w-0 items-center gap-2 whitespace-nowrap text-[15px] font-extrabold tracking-tight sm:text-base" do %>
            <span class="grid size-7 shrink-0 place-items-center rounded-lg bg-neutral text-neutral-content"><%= icon :camera, class: "size-4" %></span>
            <span class="truncate">Scavenger Hunt Party</span>
          <% end %>
          <nav class="flex shrink-0 items-center gap-1 text-sm font-semibold">
            <% if @hunt&.code.present? %>
              <%= link_to "Teams", hunt_path(@hunt.code), class: "btn btn-ghost btn-sm px-2.5" %>
              <%= link_to "Results", hunt_results_path(@hunt.code), class: "btn btn-ghost btn-sm px-2.5" %>
            <% else %>
              <%= link_to "Join", join_hunts_path, class: "btn btn-ghost btn-sm px-2.5" %>
              <%= link_to "Start a hunt", hunts_path, class: "btn btn-primary btn-sm" %>
            <% end %>
          </nav>
        </div>
      </header>
    <% end %>

    <div id="flash" class="pointer-events-none fixed inset-x-0 top-16 z-40 mx-auto flex max-w-md flex-col gap-2 px-4">
      <%= render partial: "shared/flash" %>
    </div>

    <main id="content" class="<%= "pb-32" unless @presenter_mode %>">
      <%= yield %>
    </main>

    <%= yield :bottom_bar %>
  </body>
</html>
