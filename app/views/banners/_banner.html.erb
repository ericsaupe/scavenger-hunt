<div class="pointer-events-auto flex items-start gap-3 rounded-2xl bg-neutral px-4 py-3 text-sm font-medium text-neutral-content shadow-lg ring-1 ring-base-content/10 animate-toast-in transition duration-300" role="status" data-controller="flash">
  <%= icon :info, class: "mt-0.5 size-5 shrink-0 text-marigold" %>
  <span class="grow"><%= message %></span>
  <button type="button" class="-m-1 rounded-full p-1 text-neutral-content/70 hover:text-neutral-content" aria-label="Dismiss" data-action="flash#close">
    <%= icon :x_mark, class: "size-4" %>
  </button>
</div>
