<% description "Photo scavenger hunts for friends, families, and teams. Pick a list, share a code, and race to photograph everything on it." %>

<section class="mx-auto max-w-5xl px-5 pt-10 pb-12 sm:pt-16">
  <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <h1 class="display text-5xl sm:text-6xl lg:text-7xl">Find it.<br>Snap it.<br>Score.</h1>
      <p class="mt-5 max-w-md text-lg text-ink-soft">Pick a ready-made list, share a five-letter code, and race your friends to photograph everything on it. No accounts, nothing to install.</p>

      <div class="mt-8 flex flex-col gap-3 sm:max-w-md">
        <%= link_to hunts_path, class: "btn btn-primary btn-lg" do %>
          <%= icon :flag, class: "size-5" %>
          Start a hunt
        <% end %>

        <%= form_with url: root_path, method: :get, class: "flex gap-2", data: {controller: "code"} do |form| %>
          <label for="code" class="sr-only">Hunt code</label>
          <%= form.text_field :code, value: params[:code], class: "input input-lg grow font-mono font-bold uppercase tracking-[0.3em] placeholder:font-sans placeholder:normal-case placeholder:tracking-normal placeholder:font-normal", placeholder: "Have a code?", maxlength: 5, autocomplete: "off", autocapitalize: "characters", spellcheck: false, data: {action: "input->code#normalize"} %>
          <%= form.button "Join", class: "btn btn-lg btn-outline" %>
        <% end %>
      </div>
    </div>

    <div class="relative mx-auto h-64 w-full max-w-sm sm:h-72" aria-hidden="true">
      <figure class="polaroid absolute left-0 top-8 w-36 sm:w-40" style="--tilt: -8deg">
        <%= image_tag "templates/neighborhood.jpg", class: "aspect-square w-full object-cover", alt: "" %>
        <figcaption class="pt-2 text-center text-sm font-semibold text-ink">A blue door</figcaption>
      </figure>
      <figure class="polaroid absolute right-0 top-10 w-36 sm:w-40" style="--tilt: 7deg">
        <%= image_tag "templates/beach.jpg", class: "aspect-square w-full object-cover", alt: "" %>
        <figcaption class="pt-2 text-center text-sm font-semibold text-ink">Sunglasses</figcaption>
      </figure>
      <figure class="polaroid absolute left-1/2 top-0 z-10 w-36 -translate-x-1/2 sm:w-40" style="--tilt: 2deg">
        <%= image_tag "templates/camping.jpg", class: "aspect-square w-full object-cover", alt: "" %>
        <figcaption class="pt-2 text-center text-sm font-semibold text-ink">A campfire</figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="border-t border-base-300 bg-base-200">
  <div class="mx-auto max-w-5xl px-5 py-12">
    <h2 class="display text-3xl">How a hunt works</h2>
    <ol class="mt-8 grid gap-8 sm:grid-cols-2">
      <li class="flex gap-4">
        <span class="display w-8 shrink-0 text-4xl text-marigold">1</span>
        <div>
          <h3 class="text-lg font-bold">Pick a list</h3>
          <p class="mt-1 text-ink-soft">Neighborhood, beach, airport, holiday lights. Rename it and add a start or end time if you want one.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="display w-8 shrink-0 text-4xl text-marigold">2</span>
        <div>
          <h3 class="text-lg font-bold">Share the code</h3>
          <p class="mt-1 text-ink-soft">Everyone joins from one five-letter code or a QR. They pick a team or start their own.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="display w-8 shrink-0 text-4xl text-marigold">3</span>
        <div>
          <h3 class="text-lg font-bold">Hunt and snap</h3>
          <p class="mt-1 text-ink-soft">One tap per item opens the camera. When a teammate finds something, it ticks off for the whole team.</p>
        </div>
      </li>
      <li class="flex gap-4">
        <span class="display w-8 shrink-0 text-4xl text-marigold">4</span>
        <div>
          <h3 class="text-lg font-bold">Watch it back together</h3>
          <p class="mt-1 text-ink-soft">A leaderboard, every photo and video, and a presenter mode that puts them on the big screen.</p>
        </div>
      </li>
    </ol>
  </div>
</section>
