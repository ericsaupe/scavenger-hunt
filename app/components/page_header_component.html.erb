<div class="page pt-6 pb-4">
  <% if @back_to %>
    <%= link_to @back_to, class: "mb-3 inline-flex items-center gap-1 text-sm font-semibold text-ink-soft hover:text-ink" do %>
      <%= helpers.icon :arrow_left, class: "size-4" %>
      <%= @back_label %>
    <% end %>
  <% end %>
  <h1 class="display text-3xl sm:text-4xl">
    <% if @link_to %>
      <%= link_to @title, @link_to %>
    <% else %>
      <%= @title %>
    <% end %>
  </h1>
  <% if @subtitle %>
    <p class="mt-2 max-w-prose text-base text-ink-soft"><%= @subtitle %></p>
  <% end %>
  <%= content %>
</div>
