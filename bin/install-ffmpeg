#!/usr/bin/env bash
set -o errexit
set -o nounset
set -o pipefail

version="7.0.2"
release="https://github.com/eugeneware/ffmpeg-static/releases/download/b6.1.1"
dir="$(cd "$(dirname "$0")/.." && pwd)/vendor/ffmpeg"

if [ -x "$dir/ffmpeg" ] && [ -x "$dir/ffprobe" ] && "$dir/ffmpeg" -version 2>/dev/null | grep -q "^ffmpeg version ${version}"; then
  echo "ffmpeg ${version} already installed in ${dir}"
  exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

fetch() {
  curl --fail --silent --show-error --location --connect-timeout 20 --max-time 120 --retry 3 \
    --output "$tmp/$1.gz" "$release/$1-linux-x64.gz"
  echo "$2  $tmp/$1.gz" | sha256sum --check --quiet
  gunzip "$tmp/$1.gz"
  chmod +x "$tmp/$1"
}

echo "Downloading ffmpeg ${version}"
fetch ffmpeg "bfe8a8fc511530457b528c48d77b5737527b504a3797a9bc4866aeca69c2dffa"
fetch ffprobe "25d9b6ccb05e3d9de9e04e31e2506d8dd7f9f0418981965ac6df12e8d3afd067"

mkdir -p "$dir"
mv "$tmp/ffmpeg" "$tmp/ffprobe" "$dir/"
"$dir/ffmpeg" -version | head -1
